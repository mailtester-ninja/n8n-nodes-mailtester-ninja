{
	"name": "n8n-nodes-mailtester-ninja",
	"version": "0.2.0",
	"description": "n8n node for MailTester Ninja: verify email addresses in real time against their mail server and find work emails",
	"license": "MIT",
	"homepage": "https://mailtester.ninja/integrations/n8n/",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"email verification",
		"email validation",
		"email finder",
		"mailtester ninja"
	],
	"author": {
		"name": "MailTester Ninja",
		"email": "contact@mailtester.ninja"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/mailtester-ninja/n8n-nodes-mailtester-ninja.git"
	},
	"bugs": {
		"url": "https://github.com/mailtester-ninja/n8n-nodes-mailtester-ninja/issues"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/MailTesterNinjaApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/MailTesterNinja/MailTesterNinja.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "0.52.4",
		"eslint": "9.39.4",
		"prettier": "3.8.3",
		"release-it": "20.2.0",
		"typescript": "5.9.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
